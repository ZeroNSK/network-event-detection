# Настройки базы данных
DATABASE_URL=postgresql://postgres:postgres@db:5432/network_security

# Настройки JWT
# Сгенерируйте собственное значение, например: openssl rand -hex 32
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Настройки SMTP-уведомлений
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alerts@telecom.local
SMTP_TO_EMAILS=security@telecom.local
SMTP_USE_TLS=true
SMTP_USE_SSL=false
SMTP_TIMEOUT=10

# Настройки приложения
APP_NAME=Network Security Monitoring System
APP_VERSION=1.0.0
